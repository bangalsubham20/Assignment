# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://amrutam_admin:CHANGE_THIS_PASSWORD@localhost:5432/amrutam_telemedicine
DB_HOST=localhost
DB_PORT=5432
DB_USER=amrutam_admin
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME=amrutam_telemedicine
DB_POOL_MIN=5
DB_POOL_MAX=25

# Redis Configuration (Distributed Locking, Caching, Queues)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Secrets (Generate strong 32+ char random strings for production)
JWT_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_RANDOM_JWT_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Field-Level Encryption Key (32-byte hex for AES-256-GCM PHI Protection)
# Must be exactly 64 hexadecimal characters (32 bytes)
ENCRYPTION_MASTER_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
ENCRYPTION_KEY_ID=kms-v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Observability
METRICS_PORT=4000
LOG_LEVEL=info
